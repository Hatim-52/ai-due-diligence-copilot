# Google Gemini API Configuration
GEMINI_API_KEY=your_api_key_here

# Model Configurations (Optional - defaults to supported models)
# Recommended Generation Models: gemini-2.5-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-2.5-flash

# Recommended Embedding Models: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Server Port
PORT=8000
